<!DOCTYPE html>
<html>
  <head>
    <style>
      .container{
        display:flex;
        flex-direction:column;
        border:2px solid black;
        width:150px;
        gap:20px;
      }
      .box{
        width:100px;
        height:100px;
        background-color:lightgreen;
        border:2px solid green;
        
        text-align:center;
      }

    </style>
  </head>
  <body>
    <div class="container">
      <div class="box">1</div>
      <div class="box">2</div>
      <div class="box">3</div>
    </div>
  </body>
</html>
